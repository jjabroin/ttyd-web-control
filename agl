#!/usr/bin/env python3
import os
import sys
import json
import shutil
import subprocess
import termios
import tty
import re
from datetime import datetime

BASE_HOME = os.environ.get("AGY_HOME", os.path.expanduser("~"))
CACHE_FILE = os.path.join(BASE_HOME, ".antigravity_quota_cache.json")
ACCOUNTS_JSON = os.path.join(BASE_HOME, ".antigravity_accounts.json")
AGY_PATH = os.environ.get("AGY_PATH") or shutil.which("agy") or os.path.join(BASE_HOME, ".local/bin/agy")
SWIFT_FILE = os.path.join(BASE_HOME, "Desktop/antigravity-work/AntigravityLauncher.swift")

def load_accounts():
    # 1순위: ~/.antigravity_accounts.json (Swift 앱이 실시간 동기화/저장하는 파일)
    if os.path.exists(ACCOUNTS_JSON):
        try:
            with open(ACCOUNTS_JSON, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, list) and len(data) > 0:
                    accounts = []
                    for item in data:
                        if isinstance(item, dict) and "id" in item and "home" in item:
                            accounts.append({
                                "id": item["id"],
                                "home": item["home"]
                            })
                    if accounts:
                        return accounts
        except Exception:
            pass

    # 2순위: Swift 소스코드 파싱
    accounts = []
    if os.path.exists(SWIFT_FILE):
        try:
            with open(SWIFT_FILE, 'r', encoding='utf-8') as f:
                content = f.read()
            pattern = r'Account\(id:\s*"([^"]+)",\s*home:\s*([^\)]+)\)'
            matches = re.findall(pattern, content)
            for acc_id, home_expr in matches:
                home_path = home_expr.strip().replace('base + "', BASE_HOME + '/').replace('base', BASE_HOME).replace('"', '')
                accounts.append({"id": acc_id, "home": home_path})
        except Exception:
            pass

    if not accounts:
        accounts = [
            {"id": "기본", "home": BASE_HOME},
            {"id": "학교", "home": os.path.join(BASE_HOME, ".agy_account2")},
            {"id": "클로", "home": os.path.join(BASE_HOME, ".agy_account3")},
            {"id": "짭로인", "home": os.path.join(BASE_HOME, ".agy_account4")},
            {"id": "반중력5", "home": os.path.join(BASE_HOME, ".agy_account5")},
            {"id": "반중력6", "home": os.path.join(BASE_HOME, ".agy_account6")},
            {"id": "애플", "home": os.path.join(BASE_HOME, ".agy_account7")}
        ]
    return accounts

def create_account_env_if_needed(target_home):
    """새 계정 환경(홈 디렉토리 심볼릭 링크 등) 자동 구성"""
    if target_home == BASE_HOME:
        return
    gemini = os.path.join(target_home, ".gemini")
    config_dir = os.path.join(gemini, "config")
    cli_dir = os.path.join(gemini, "antigravity-cli")

    os.makedirs(config_dir, exist_ok=True)
    os.makedirs(cli_dir, exist_ok=True)

    shared = ["state.json", "settings.json", "projects", "projects.json", "sessions", "history"]
    for name in shared:
        link = os.path.join(gemini, name)
        target = os.path.join(BASE_HOME, ".gemini", name)
        if not os.path.exists(link) and not os.path.islink(link):
            try:
                os.symlink(target, link)
            except Exception:
                pass

    shared_cli = ["conversation_summaries.db", "conversations", "brain", "log", "history.jsonl"]
    for name in shared_cli:
        link = os.path.join(cli_dir, name)
        target = os.path.join(BASE_HOME, ".gemini", "antigravity-cli", name)
        if not os.path.exists(link) and not os.path.islink(link):
            try:
                os.symlink(target, link)
            except Exception:
                pass

def get_key():
    import select as _select
    fd = sys.stdin.fileno()
    try:
        old_settings = termios.tcgetattr(fd)
    except Exception:
        old_settings = None

    try:
        if old_settings:
            tty.setraw(fd)

        # 첫 바이트 읽기 (블로킹)
        ch = sys.stdin.read(1)

        if ch == '\x1b':
            # 나머지 시퀀스 바이트를 한 번에 모아 읽기 (500ms 대기)
            buf = ch
            deadline = 0.5  # 총 500ms 안에 전체 시퀀스를 읽음
            while True:
                r, _, _ = _select.select([sys.stdin], [], [], deadline)
                if not r:
                    break
                nch = sys.stdin.read(1)
                buf += nch
                deadline = 0.05  # 첫 바이트 들어온 뒤엔 빠르게 이어받음
                if len(buf) >= 3:
                    break

            if buf == '\x1b[A': return 'UP'
            if buf == '\x1b[B': return 'DOWN'
            if buf == '\x1b[C': return 'RIGHT'
            if buf == '\x1b[D': return 'LEFT'
            # 단독 ESC는 그냥 무시 (종료 유발 안 함)
            return None

        if ch == '\t': return 'REFRESH'  # Tab: 새로고침
        if ch in ('\r', '\n'): return 'ENTER'
        if ch == '\x03': return 'QUIT'  # Ctrl+C
        if ch in ('q', 'Q'): return 'QUIT'  # q 로도 종료 가능
        if ch in '123456789': return ch
        return ch
    finally:
        if old_settings:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def load_data():
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception:
            pass
    return {"updated_at": "불러오는 중", "data": {}}

def format_reset_time(iso_str):
    if not iso_str:
        return None
    try:
        dt = None
        for fmt in ("%Y-%m-%dT%H:%M:%S.%fZ", "%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S"):
            try:
                dt = datetime.strptime(iso_str, fmt)
                break
            except ValueError:
                pass
        if not dt:
            return None
        now = datetime.utcnow()
        diff = int((dt - now).total_seconds())
        if diff <= 0:
            return "초기화됨"
        hours = diff // 3600
        minutes = (diff % 3600) // 60
        seconds = diff % 60
        if diff < 60:
            return f"{seconds}초 후"
        elif diff < 86400:
            return f"{hours}시간 {minutes}분 후"
        else:
            days = diff // 86400
            rem_h = hours % 24
            return f"{days}일 {rem_h}시간 후"
    except Exception:
        return None

def draw_menu(selected_idx, accounts, data_obj):
    os.system('clear')
    updated_at = data_obj.get("updated_at", "불러오는 중")
    data = data_obj.get("data", {})

    print("\033[1;36m=====================================================\033[0m")
    print("       🚀 \033[1;37mAntigravity Quota Launcher (CLI)\033[0m")
    print(f"       \033[90m마지막 업데이트: {updated_at}\033[0m")
    print("\033[1;36m=====================================================\033[0m\n")

    for idx, acc in enumerate(accounts):
        acc_id = acc["id"]
        info = data.get(acc_id)
        is_selected = (idx == selected_idx)
        
        prefix = " 👉 " if is_selected else "    "
        bg_color = "\033[1;44m" if is_selected else "\033[1;32m"
        reset = "\033[0m"
        num_str = f"[{idx+1}]"

        print(f"{prefix}\033[1;33m{num_str}\033[0m {bg_color} [{acc_id}] {reset}")
        
        if info:
            gemini = info.get("gemini", "0")
            gemini_reset = format_reset_time(info.get("gemini_reset"))
            claude = info.get("claude", "0")
            claude_reset = format_reset_time(info.get("claude_reset"))

            g_reset_str = f" ({gemini_reset})" if gemini_reset else ""
            c_reset_str = f" ({claude_reset})" if claude_reset else ""
            print(f"       \033[1mGemini\033[0m: {gemini}%{g_reset_str} | \033[1mClaude\033[0m: {claude}%{c_reset_str}")
        else:
            print("       \033[90m새 계정 자리 — 실행 후 Google 계정으로 로그인하세요\033[0m")
        print()

    count = len(accounts)
    print("\033[90m-----------------------------------------------------\033[0m")
    print(f" 💡 \033[1;33m[↑/↓]\033[0m 이동  |  \033[1;33m[숫자1~{count}]\033[0m 바로선택  |  \033[1;32m[Enter]\033[0m 실행")
    print("    \033[1;35m[Tab]\033[0m 새로고침  |  \033[1;31m[Esc]\033[0m 종료")
    print("\033[90m-----------------------------------------------------\033[0m")

def run_account(acc):
    acc_id = acc["id"]
    target_home = acc["home"]
    
    create_account_env_if_needed(target_home)

    try:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, termios.tcgetattr(sys.stdin.fileno()))
    except Exception:
        pass
    os.system('clear')
    print(f"\033[1;32m🚀 '{acc_id}' 계정으로 Antigravity CLI를 실행합니다...\033[0m\n")

    env = os.environ.copy()
    env["HOME"] = target_home
    env["PYTHON_KEYRING_BACKEND"] = "keyring.backends.null.Keyring"
    env["AGY_USE_KEYRING"] = "false"

    cmd = [AGY_PATH, "--dangerously-skip-permissions"]
    try:
        subprocess.run(cmd, env=env)
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print(f"\n\033[1;31m실행 중 오류 발생: {e}\033[0m")
        input("\n[Enter]를 누르면 메인 메뉴로 돌아갑니다...")

def main():
    selected_idx = 0
    try:
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    except Exception:
        pass
    while True:
        accounts = load_accounts()
        data_obj = load_data()
        if selected_idx >= len(accounts):
            selected_idx = len(accounts) - 1

        draw_menu(selected_idx, accounts, data_obj)
        key = get_key()

        if key == 'UP':
            selected_idx = (selected_idx - 1) % len(accounts)
        elif key == 'DOWN':
            selected_idx = (selected_idx + 1) % len(accounts)
        elif key in '123456789':
            idx = int(key) - 1
            if idx < len(accounts):
                target_acc = accounts[idx]
                run_account(target_acc)
                data_obj = load_data()
        elif key == 'ENTER':
            target_acc = accounts[selected_idx]
            run_account(target_acc)
            data_obj = load_data()
        elif key == 'REFRESH':
            os.system('clear')
            print("\033[1;34m쿼터 정보를 새로고침 중입니다...\033[0m")
            py_fetcher = os.path.join(BASE_HOME, ".antigravity_quota_fetcher.py")
            if os.path.exists(py_fetcher):
                subprocess.run(["/usr/bin/python3", py_fetcher, "--update"])
            data_obj = load_data()
        elif key in ('QUIT', 'q'):
            os.system('clear')
            print("Antigravity Launcher CLI를 종료합니다.")
            break

if __name__ == "__main__":
    main()
